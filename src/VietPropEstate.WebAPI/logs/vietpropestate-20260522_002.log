) AS [p2] ON [p1].[PropertyTypeId] = [p2].[Id]
INNER JOIN (
    SELECT [a].[Id], [a].[AgencyName], [a].[AvatarUrl], [a].[Bio], [a].[CreatedAt], [a].[CreatedBy], [a].[DeletedAt], [a].[DeletedBy], [a].[Email], [a].[FullName], [a].[IsActive], [a].[IsDeleted], [a].[LastModifiedAt], [a].[LastModifiedBy], [a].[LicenseNumber], [a].[PhoneNumber], [a].[RowVersion], [a].[UserId]
    FROM [Agents] AS [a]
    WHERE [a].[IsDeleted] = CAST(0 AS bit)
) AS [a0] ON [p1].[AgentId] = [a0].[Id]
LEFT JOIN (
    SELECT [t].[Id], [t].[CreatedAt], [t].[CreatedBy], [t].[DeletedAt], [t].[DeletedBy], [t].[Description], [t].[IsActive], [t].[IsDeleted], [t].[LastModifiedAt], [t].[LastModifiedBy], [t].[Name], [t].[RowVersion]
    FROM [TransactionTypes] AS [t]
    WHERE [t].[IsDeleted] = CAST(0 AS bit)
) AS [t0] ON [p1].[TransactionTypeId] = [t0].[Id]
LEFT JOIN (
    SELECT [p3].[Id], [p3].[Caption], [p3].[CreatedAt], [p3].[CreatedBy], [p3].[DeletedAt], [p3].[DeletedBy], [p3].[DisplayOrder], [p3].[IsDeleted], [p3].[IsPrimary], [p3].[LastModifiedAt], [p3].[LastModifiedBy], [p3].[PropertyId], [p3].[RowVersion], [p3].[Url]
    FROM [PropertyImages] AS [p3]
    WHERE [p3].[IsDeleted] = CAST(0 AS bit)
) AS [p4] ON [p1].[Id] = [p4].[PropertyId]
ORDER BY [p1].[CreatedAt] DESC, [p1].[Id], [p2].[Id], [a0].[Id], [t0].[Id]

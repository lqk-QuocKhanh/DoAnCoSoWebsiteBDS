@inject NavigationManager Nav
@inject AuthState AuthState
@implements IDisposable

@if (AuthState.IsAuthenticated)
{
    <div class="support-chat-widget" style="@PositionStyle">
        @if (_panelOpen)
        {
            <div class="support-chat-panel">
                <div class="support-chat-panel-header">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center" style="gap:10px;">
                            <MudAvatar Style="background:rgba(255,255,255,0.2); color:#fff; width:36px; height:36px;">
                                <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="color:#fff; font-weight:700; line-height:1.2;">
                                    Hỗ trợ VietPropEstate
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.85);">
                                    Admin sẵn sàng hỗ trợ bạn
                                </MudText>
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                         Style="color:#fff;" OnClick="@ClosePanel" />
                    </div>
                    <MudText Class="support-chat-hint" Style="margin-top:10px; line-height:1.5;">
                        Bạn có thắc mắc? Liên hệ Admin qua website, Zalo hoặc Facebook.
                    </MudText>
                </div>

                <div class="support-chat-panel-body">
                    <button type="button" class="support-chat-option" @onclick="OpenWebsiteSupport">
                        <span class="support-chat-option-icon website">
                            <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />
                        </span>
                        <span class="support-chat-option-text">
                            <div class="support-chat-option-title">Nhắn tin trên website</div>
                            <div class="support-chat-option-subtitle">Mở tin nhắn để trao đổi với Admin</div>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="color:#94A3B8;" />
                    </button>

                    <a class="support-chat-option" href="@ZaloUrl" target="_blank" rel="noopener noreferrer"
                       title="Mở Zalo @ZaloPhoneDisplay" @onclick="ClosePanel">
                        <span class="support-chat-option-icon zalo">
                            <img src="icons/zalo.svg" alt="Zalo" class="support-chat-brand-icon" />
                        </span>
                        <span class="support-chat-option-text">
                            <div class="support-chat-option-title">Chat qua Zalo</div>
                            <div class="support-chat-option-subtitle">@ZaloPhoneDisplay</div>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="color:#94A3B8;" />
                    </a>

                    <a class="support-chat-option" href="@FacebookUrl" target="_blank" rel="noopener noreferrer"
                       title="Mở Facebook Lê Quốc Khánh" @onclick="ClosePanel">
                        <span class="support-chat-option-icon facebook">
                            <img src="icons/facebook.svg" alt="Facebook" class="support-chat-brand-icon" />
                        </span>
                        <span class="support-chat-option-text">
                            <div class="support-chat-option-title">Facebook Messenger</div>
                            <div class="support-chat-option-subtitle">Lê Quốc Khánh</div>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="color:#94A3B8;" />
                    </a>
                </div>
            </div>
        }

        <div class="support-chat-bubble-wrap">
            @if (!_panelOpen)
            {
                <span class="support-chat-bubble-badge"></span>
            }
            <button type="button"
                    class="support-chat-bubble @(_dragging ? "dragging" : "")"
                    title="Kéo để di chuyển · Nhấn để mở hỗ trợ"
                    aria-label="Hỗ trợ liên hệ Admin"
                    @onpointerdown="OnBubblePointerDown"
                    @onpointerup="OnPointerUp"
                    @onpointercancel="OnPointerUp">
                <span class="material-icons" style="font-size:28px;">
                    @(_panelOpen ? "close" : "support_agent")
                </span>
            </button>
        </div>
    </div>

    @if (_dragging)
    {
        <div class="support-chat-overlay"
             @onpointermove="OnPointerMove"
             @onpointerup="OnPointerUp"
             @onpointercancel="OnPointerUp"></div>
    }
}

@code {
    private const string ZaloPhoneDisplay = "0327 890 430";
    private const string ZaloUrl = "https://zalo.me/0327890430";
    private const string FacebookUrl = "https://www.facebook.com/lqkhanh99";

    private bool _panelOpen;
    private bool _dragging;
    private bool _didDrag;

    private double _right = 24;
    private double _bottom = 24;
    private double _dragStartX;
    private double _dragStartY;
    private double _dragStartRight;
    private double _dragStartBottom;

    private string PositionStyle =>
        $"right:{_right.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
        $"bottom:{_bottom.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

    protected override void OnInitialized() => AuthState.OnChange += HandleAuthChanged;

    private void HandleAuthChanged()
    {
        if (!AuthState.IsAuthenticated)
            _panelOpen = false;

        InvokeAsync(StateHasChanged);
    }

    private void OnBubblePointerDown(PointerEventArgs e)
    {
        _dragging = true;
        _didDrag = false;
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
        _dragStartRight = _right;
        _dragStartBottom = _bottom;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_dragging) return;

        var dx = e.ClientX - _dragStartX;
        var dy = e.ClientY - _dragStartY;

        if (Math.Abs(dx) > 4 || Math.Abs(dy) > 4)
            _didDrag = true;

        _right = Math.Clamp(_dragStartRight - dx, 8, 600);
        _bottom = Math.Clamp(_dragStartBottom - dy, 8, 800);
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (_dragging && !_didDrag)
            _panelOpen = !_panelOpen;

        _dragging = false;
    }

    private void ClosePanel() => _panelOpen = false;

    private void OpenWebsiteSupport()
    {
        _panelOpen = false;
        Nav.NavigateTo("/dashboard/tin-nhan");
    }

    public void Dispose() => AuthState.OnChange -= HandleAuthChanged;
}

@inject IMediaUrlResolver MediaUrls

<img src="@ResolvedSrc" alt="@Alt" class="@Class" style="@Style" loading="@Loading"
     onerror="this.onerror=null;this.src='@DefaultFallback';" />

@code {
    public const string DefaultFallback = "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1200&q=85&auto=format&fit=crop";

    [Parameter] public string? Url { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string Loading { get; set; } = "lazy";

    private string ResolvedSrc
    {
        get
        {
            var resolved = MediaUrls.Resolve(Url);
            return string.IsNullOrWhiteSpace(resolved) ? DefaultFallback : resolved;
        }
    }
}

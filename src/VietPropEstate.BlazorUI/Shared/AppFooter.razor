<footer class="app-footer app-footer--urbn mt-auto">
    <div style="max-width:1280px; margin:0 auto; padding:0 32px;">
        <MudGrid>
            <MudItem xs="12" md="4" Class="mb-6 mb-md-0">
                <span class="footer-brand">VIETPROPESTATE</span>
                <MudText Style="color:#64748B; font-size:14px; line-height:1.6; margin-top:12px;">
                    Nền tảng mua bán và cho thuê bất động sản uy tín hàng đầu Việt Nam.
                </MudText>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudText Class="footer-heading" Style="margin-bottom:16px;">Dịch vụ</MudText>
                <div class="d-flex flex-column" style="gap:10px;">
                    <MudLink Href="/bat-dong-san?listingType=1" Class="footer-link">Mua bán</MudLink>
                    <MudLink Href="/bat-dong-san?listingType=2" Class="footer-link">Cho thuê</MudLink>
                    <MudLink Href="/dashboard/goi-vip" Class="footer-link">Gói VIP</MudLink>
                    <MudLink Href="/dashboard/tin-dang/them-moi" Class="footer-link">Đăng tin</MudLink>
                </div>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudText Class="footer-heading" Style="margin-bottom:16px;">Hỗ trợ</MudText>
                <div class="d-flex flex-column" style="gap:10px;">
                    <MudLink Href="#" Class="footer-link">FAQ</MudLink>
                    <MudLink Href="#" Class="footer-link">Hướng dẫn</MudLink>
                    <MudLink Href="#" Class="footer-link">Bảo mật</MudLink>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Class="footer-heading" Style="margin-bottom:16px;">Liên hệ</MudText>
                <MudText Class="footer-link">support@vietpropestate.vn</MudText>
                <MudText Class="footer-link">1900 1234</MudText>
            </MudItem>
        </MudGrid>
        <MudDivider Style="margin:32px 0 24px;" />
        <MudText Style="color:#94A3B8; font-size:13px;">
            © @DateTime.Now.Year VietPropEstate. All rights reserved.
        </MudText>
    </div>
</footer>

@inherits LayoutComponentBase

<div class="auth-layout">
    <div class="auth-layout-visual">
        <div class="auth-layout-visual-bg" style="background-image:url('/images/hero-saigon-skyline.png')"></div>
        <div class="auth-layout-visual-overlay"></div>
        <div class="auth-layout-visual-content">
            <h1 class="urbn-hero-title urbn-hero-title--auth">
                <span class="urbn-hero-title-line">NÂNG TẦM GIÁ TRỊ</span>
                <span class="urbn-hero-title-flare" aria-hidden="true"></span>
                <span class="urbn-hero-title-line">MỞ LỐI THỊNH VƯỢNG</span>
            </h1>
            <p class="urbn-hero-subtitle urbn-hero-subtitle--auth">
                Mua • Bán • Cho thuê bất động sản minh bạch • Nhanh chóng • An toàn
            </p>
            <p>Nền tảng bất động sản cao cấp — hàng nghìn tin đăng được xác thực trên toàn quốc.</p>
        </div>
    </div>

    <div class="auth-layout-form">
        <div class="auth-layout-form-header">
            <MudLink Href="/" Underline="Underline.None" Class="auth-layout-logo">VIETPROPESTATE</MudLink>
            <MudLink Href="/" Style="font-size:13px; color:#64748B; text-decoration:none;">← Về trang chủ</MudLink>
        </div>
        <div class="auth-layout-form-body">
            @Body
        </div>
    </div>
</div>

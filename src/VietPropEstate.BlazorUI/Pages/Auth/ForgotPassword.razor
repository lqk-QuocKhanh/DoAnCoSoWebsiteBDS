@page "/quen-mat-khau"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject ISnackbar Snackbar

<PageTitle>Quên mật khẩu - VietPropEstate</PageTitle>

<div class="auth-form">
    @if (!_sent)
    {
        <h1 class="auth-form-title">Quên mật khẩu?</h1>
        <p class="auth-form-subtitle">Nhập email của bạn để nhận hướng dẫn đặt lại mật khẩu.</p>

        <div class="d-flex flex-column" style="gap:20px;">
            <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined"
                          InputType="InputType.Email" Placeholder="email@example.com" Disabled="@_loading" />

            <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="@HandleSubmit" Disabled="@_loading"
                       Class="auth-btn-primary">
                @(_loading ? "Đang gửi..." : "Gửi email khôi phục")
            </MudButton>

            <div style="text-align:center;">
                <MudLink Href="/dang-nhap" Class="auth-link" Style="font-size:13px;">← Quay lại đăng nhập</MudLink>
            </div>
        </div>
    }
    else
    {
        <div style="text-align:center; padding:8px 0;">
            <div style="width:72px;height:72px;background:#F1F5F9;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
                <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Style="color:#0F172A; font-size:36px;" />
            </div>
            <h1 class="auth-form-title" style="font-size:1.35rem;">Email đã được gửi</h1>
            <p class="auth-form-subtitle" style="margin-bottom:24px;">
                Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu đến <strong>@_email</strong>. Vui lòng kiểm tra hộp thư (kể cả thư mục spam).
            </p>
            <MudButton Href="/dang-nhap" Variant="Variant.Outlined" Class="auth-btn-outline">
                Quay lại đăng nhập
            </MudButton>
        </div>
    }
</div>

@code {
    private string _email = "";
    private bool _loading;
    private bool _sent;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _loading = true;
        await AuthClient.ForgotPasswordAsync(_email);
        _sent = true;
        _loading = false;
    }
}
